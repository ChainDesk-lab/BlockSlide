{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node20",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "hardhat.config.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "ignition/**/*.ts",
    // Contract types generated by `hardhat build`, so getContractAt/deployContract are typed
    "artifacts/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "cache",
    "frontend",
    "subgraph"
  ]
}
