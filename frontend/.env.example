# Copy to .env.local for local dev, and set the same keys in the Vercel project
# (Production, Preview, Development) for deployments.

# --- Wallet connect (mobile) -------------------------------------------------
# REQUIRED for mobile wallet users. Without it the WalletConnect connector is
# not registered, so a phone browser has no deep-link connect path and can only
# fall back to opening BlockSlide inside the MetaMask app's own browser.
# Create a free project at https://cloud.reown.com and paste its Project ID.
# Add the deployed origin (https://blockslide.app) to the project's allowlist.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical origin shown to the user on their wallet's approval screen and used
# to return them to this tab after they approve. Defaults to
# https://blockslide.app; override for a preview deployment.
NEXT_PUBLIC_APP_URL=

# --- Email login (Magic.link) ---------------------------------------------------
NEXT_PUBLIC_MAGIC_API_KEY=

# --- Leaderboard / profile data ----------------------------------------------
NEXT_PUBLIC_SUBGRAPH_URL=

# --- Automatic CELO for new email wallets (/api/fund-wallet) -------------------
# Server-only. OFF unless set to "true". Leave unset to keep it disabled.
FUND_WALLET_ENABLED=
# A dedicated low-balance wallet for gas top-ups. NEVER the contract owner key:
# the route refuses to send if this key's address is Game2048.owner().
# FUNDING_WALLET_PRIVATE_KEY is no longer read — delete it from Vercel.
GAS_FUNDER_PRIVATE_KEY=
# Maximum payouts per UTC day (default 20, i.e. at most 1 CELO/day at 0.05 each).
FUND_WALLET_DAILY_CAP=
