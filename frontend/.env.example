# Copy to .env.local for local dev, and set the same keys in the Vercel project
# (Production, Preview, Development) for deployments.

# --- Wallet connect (mobile) -------------------------------------------------
# REQUIRED for mobile wallet users. Without it the WalletConnect connector is
# not registered, so a phone browser has no deep-link connect path and can only
# fall back to opening BlockSlide inside the MetaMask app's own browser.
# Create a free project at https://cloud.reown.com and paste its Project ID.
# Add the deployed origin (https://blockslide.app) to the project's allowlist.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Canonical origin shown to the user on their wallet's approval screen and used
# to return them to this tab after they approve. Defaults to
# https://blockslide.app; override for a preview deployment.
NEXT_PUBLIC_APP_URL=

# --- Email login (Magic.link) ---------------------------------------------------
NEXT_PUBLIC_MAGIC_API_KEY=

# --- Leaderboard / profile data ----------------------------------------------
NEXT_PUBLIC_SUBGRAPH_URL=

# --- Automatic CELO for new email wallets (/api/fund-wallet) -------------------
# Server-only. OFF unless set to "true". Leave unset to keep it disabled.
FUND_WALLET_ENABLED=
# A dedicated low-balance wallet for gas top-ups. NEVER the contract owner key:
# the route refuses to send if this key's address is Game2048.owner().
# FUNDING_WALLET_PRIVATE_KEY is no longer read — delete it from Vercel.
GAS_FUNDER_PRIVATE_KEY=
# Maximum payouts per UTC day (default 20, i.e. at most 1 CELO/day at 0.05 each).
FUND_WALLET_DAILY_CAP=

# Server-only. Blocks the subgraph may trail chain head before /api/leaderboard
# reports `stale: true`. Celo makes ~1 block per second, so the default of 600
# is about 10 minutes. Leave unset to use the default.
LEADERBOARD_MAX_LAG_BLOCKS=

# --- Admins (local testing only) ------------------------------------------------
# The admin page (/admin/payouts) is only shown to the admin wallets in src/config/admins.ts, who
# sign in with a free wallet signature. On the live site that list is fixed in code. For local
# development only, extra test admin wallets can be added here (comma-separated); ignored in production.
NEXT_PUBLIC_ADMIN_WALLETS=

# --- Invite links: owner key for scripts (/api/referrals/export) ----------------
# Server-only. A key for downloading every invite (who invited whom) without the admin page.
# The export is off until this is set. Use a long random value, e.g. `openssl rand -hex 32`:
#   curl -H "Authorization: Bearer <key>" "https://blockslide.app/api/referrals/export?format=csv"
REFERRALS_EXPORT_SECRET=

# --- Owner notifications (Telegram) --------------------------------------------
# Server-only. A Telegram bot that messages the owner when a player requests a referral payment.
# Create the bot with @BotFather (it gives the token), add it to your chat or group, and put that
# chat's id here (for a group it starts with -100). Without both, requests are still saved and
# listed at /admin/payouts; only the message is skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Server RPC ---------------------------------------------------------------
# Server-only, comma-separated. Used for chain head (/api/leaderboard, /stats),
# event scans (/stats) and on-chain username checks (/api/players). Defaults to
# https://forno.celo.org when unset.
CELO_RPC_URLS=
